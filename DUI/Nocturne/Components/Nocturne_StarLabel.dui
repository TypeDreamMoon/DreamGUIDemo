// A star's label in the NOCTURNE//OS star map (UNocturneStarLabel): a ring around the star, the star's glyph, its name
// and English tag, its number; and, while the star is in focus, an arc turning outside the ring, a line of description
// and what Enter does. Stood in the world at the star by a world widget whose pivot is the ring's centre, turned to face
// the camera. Everything here is placed from the ring's centre: (60, 0) from the left middle of the 460 x 190 rect the
// world widget gives the label.
//
// The text sits on a dark plate, so a constellation line passing behind a label never runs through its letters. The
// plate's width is set per star from its text, and it grows down over the description while the star is in focus.
class /Game/Nocturne/UI/Components/WBP_Nocturne_StarLabel
use "Nocturne/Nocturne_Common.dui"

style RingAt {
    AnchorData.AnchorMin = (0, 0.5)
    AnchorData.AnchorMax = (0, 0.5)
    AnchorData.Pivot = (0.5, 0.5)
    AnchorData.AnchoredPosition = (60, 0)
}

Widget Root : Fill {
    + UIButton { TransitionType = None }

    // What takes the pointer: the ring and the text beside it.
    RectBlock HitArea : Bar {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (10, 6)
        AnchorData.SizeDelta = (330, 116)
        BodyColor = @Clear
        bRaycastTarget = true
    }

    // Behind the text, from just past the focus arc: its top-left corner is fixed, its size follows the text and the
    // focus. A hairline along its top, and a short tab at the corner that lights with the focus.
    RectBlock Plate : Bar {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 1)
        AnchorData.AnchoredPosition = (116, 66)
        AnchorData.SizeDelta = (200, 108)
        BodyColor = #05080C8C

        RectBlock PlateRule : Bar {
            AnchorData.AnchorMin = (0, 1)
            AnchorData.AnchorMax = (1, 1)
            AnchorData.Pivot = (0.5, 1)
            AnchorData.SizeDelta = (0, 1)
        }
        RectBlock PlateTab : AccentBar {
            AnchorData.AnchorMin = (0, 1)
            AnchorData.AnchorMax = (0, 1)
            AnchorData.Pivot = (0, 1)
            AnchorData.SizeDelta = (28, 2)
        }
    }

    Ring Arc : RingAt {
        AnchorData.SizeDelta = (104, 104)
        StartAngle = 0
        EndAngle = 70
        LineWidth = 2
        Segment = 32
        Color = @Cyan
    }
    PolygonLine Hex : RingAt {
        AnchorData.SizeDelta = (92, 92)
        Sides = 6
        LineWidth = 1
        Color = #8FE3FF66
        bRaycastTarget = false
    }
    Ring Halo : RingAt {
        AnchorData.SizeDelta = (76, 76)
        StartAngle = 0
        EndAngle = 360
        LineWidth = 1.5
        Segment = 64
        Color = #8FE3FF88
    }
    RectBlock Leader : Bar {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (98, 14)
        AnchorData.SizeDelta = (18, 1.5)
        BodyColor = #8FE3FF88
    }

    Text Number : Meta {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (128, 50)
        AnchorData.SizeDelta = (60, 20)
        FontSize = 12
        Color = @Cyan
    }
    Text GlyphText : Heading {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (128, 14)
        AnchorData.SizeDelta = (200, 56)
        FontSize = 42
    }
    Text NameText : Label {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (130, -24)
        AnchorData.SizeDelta = (80, 24)
        FontSize = 16
        Color = @InkDim
    }
    Text EnText : SubLabel {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (214, -25)
        AnchorData.SizeDelta = (200, 24)
        FontSize = 12
    }

    // Shown while in focus.
    Widget Details {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 1)
        AnchorData.AnchoredPosition = (130, -46)
        AnchorData.SizeDelta = (330, 52)
        Raycastable = Disabled

        Text DescText : Label {
            AnchorData.AnchorMin = (0, 1)
            AnchorData.AnchorMax = (1, 1)
            AnchorData.Pivot = (0.5, 1)
            AnchorData.SizeDelta = (0, 22)
            FontSize = 14
            Color = @InkDim
        }
        RectBlock EnterCap : Bar {
            AnchorData.AnchorMin = (0, 0)
            AnchorData.AnchorMax = (0, 0)
            AnchorData.Pivot = (0, 0)
            AnchorData.SizeDelta = (58, 20)
            bEnableBody = false
            bEnableBorder = true
            BorderWidth = 1
            BorderColor = #8FE3FF99
        }
        Text EnterKey : Tag {
            AnchorData.AnchorMin = (0, 0)
            AnchorData.AnchorMax = (0, 0)
            AnchorData.Pivot = (0, 0)
            AnchorData.SizeDelta = (58, 20)
            FontSize = 11
            FontSpace = (1, 0)
            HAlign = Center
            Text = "ENTER" @noloc
        }
        Text EnterText : Label {
            AnchorData.AnchorMin = (0, 0)
            AnchorData.AnchorMax = (0, 0)
            AnchorData.Pivot = (0, 0)
            AnchorData.AnchoredPosition = (68, 0)
            AnchorData.SizeDelta = (240, 20)
            FontSize = 14
            Color = @Cyan
            Text = "进入"
        }
        Text LockedText : Label {
            AnchorData.AnchorMin = (0, 0)
            AnchorData.AnchorMax = (0, 0)
            AnchorData.Pivot = (0, 0)
            AnchorData.SizeDelta = (300, 20)
            FontSize = 14
            Color = @Amber
            Text = "未开放  ·  LOCKED"
        }
    }
}
