// The tooltip of an archive item (UNocturneItemTip): name, English tag, kind and rarity, one line about it. DreamGUI's
// tooltip service shows it after the pointer rests on a slot; it finds its item through the slot the tooltip is for.
class /Game/Nocturne/UI/Components/WBP_Nocturne_ItemTip
use "Nocturne/Nocturne_Common.dui"

Widget Root {
    AnchorData.SizeDelta = (320, 116)
    Raycastable = Disabled

    RectBlock TipBack : Bar {
        AnchorData.AnchorMin = (0, 0)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.SizeDelta = (0, 0)
        BodyColor = #070A0EF0
        bEnableBorder = true
        BorderWidth = 1
        BorderColor = @LineStrong
    }
    RectBlock TipTab : Bar {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (0, 1)
        AnchorData.Pivot = (0, 1)
        AnchorData.AnchoredPosition = (16, 0)
        AnchorData.SizeDelta = (40, 3)
        BodyColor = @Cyan
    }
    Text TipName : Label {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.Pivot = (0.5, 1)
        AnchorData.AnchoredPosition = (0, -16)
        AnchorData.SizeDelta = (-32, 26)
        FontSize = 19
    }
    Text TipEn : Tag {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.Pivot = (0.5, 1)
        AnchorData.AnchoredPosition = (0, -46)
        AnchorData.SizeDelta = (-32, 16)
        FontSize = 11
    }
    Text TipKind : Meta {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.Pivot = (0.5, 1)
        AnchorData.AnchoredPosition = (0, -46)
        AnchorData.SizeDelta = (-32, 16)
        FontSize = 11
        HAlign = Right
    }
    Text TipText : Label {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.Pivot = (0.5, 1)
        AnchorData.AnchoredPosition = (0, -74)
        AnchorData.SizeDelta = (-32, 22)
        FontSize = 13
        Color = @InkDim
    }
}
