                AnchorData.AnchorMin = (0, 0)
                AnchorData.AnchorMax = (1, 1)
                AnchorData.SizeDelta = (0, 0)
                BodyColor = #FFB45426
                bEnableBorder = true
                BorderWidth = 1
                BorderColor = #FFB454AA
                bRaycastTarget = true
            }
            Text ConfirmYesText : Label {
                AnchorData.AnchorMin = (0, 0)
                AnchorData.AnchorMax = (1, 1)
                AnchorData.SizeDelta = (0, 0)
                FontSize = 17
                Color = @Amber
                HAlign = Center
                Text = "确认恢复"
            }
        }
    }
}
