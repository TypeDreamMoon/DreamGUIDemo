// One tab of the system menu's nav bar (UNieRTab): its box, icon and label; while open, the ink box that drops from the
// tab to the rule below it, and the pointer at its left.
class /Game/UITests/NieR/UI/Components/NieR_Tab
use "UITests/NieR/NieR_Common.dui"

Widget Root : ComponentRoot {
    + UIButton { TransitionType = None  bCanNavigateHere = false }

    RectBlock Box : FlatFill {
        AnchorData.AnchoredPosition = (0, -1)
        BodyColor = @TabBox
        bRaycastTarget = true
    }
    // 72 px from the tab's top, growing downward.
    RectBlock SelBox : Flat {
        AnchorData.AnchorMin = (0, 1)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.Pivot = (0.5, 1)
        AnchorData.SizeDelta = (0, 72)
        BodyColor = @Ink
        bRaycastTarget = true
    }
    HorizontalBox : Fill {
        Padding = (12, 1, 0, 0)
        Spacing = 8
        Image IconImage : Picture {
            Brush.ImageSize = (30, 30)
            @slot VerticalAlignment = Center
        }
        Text LabelText : Label {
            FontSpace = (1, 0)
            @fill
        }
    }
    Image Pointer : Picture {
        AnchorData.AnchorMin = (0, 0.5)
        AnchorData.AnchorMax = (0, 0.5)
        AnchorData.Pivot = (0, 0.5)
        AnchorData.AnchoredPosition = (-40, 2)
        AnchorData.SizeDelta = (36, 18)
        Brush.ResourceObject = @CursorTexture
        Brush.TintColor = @Ink
    }
}
