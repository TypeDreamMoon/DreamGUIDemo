// M_DBH_Lit.dss -- a plain lit surface for the crime scene's props and the android built from basic shapes: a colour,
// a roughness, a metalness and an emissive (rgb times a). The game makes one dynamic instance per look.
#pragma material(Backend = Graph)

/// @group Surface|Look   @sort 10   @desc Base colour (linear)
uniform float4 Color = float4(0.5, 0.5, 0.5, 1.0);
/// @group Surface|Look   @sort 20   @slider 0 1   @desc Roughness
uniform float Roughness = 0.6;
/// @group Surface|Look   @sort 30   @slider 0 1   @desc Metalness
uniform float Metallic = 0.0;
/// @group Surface|Look   @sort 40   @desc Emissive colour (linear) times its alpha
uniform float4 Emissive = float4(0.0, 0.0, 0.0, 0.0);

export void M_DBH_Lit(inout material m)
{
    m.BaseColor = Color.rgb;
    m.Roughness = Roughness;
    m.Metallic = Metallic;
    m.EmissiveColor = Emissive.rgb * Emissive.a;
}
